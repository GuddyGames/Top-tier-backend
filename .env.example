# Server
PORT=5000
NODE_ENV=development

# Database — Supabase Postgres connection string.
# Find it in your Supabase project: Settings → Database → Connection string
# (choose "URI"). Use the "Connection pooling" string (port 6543) if you're
# deploying to a serverless host; use the direct string (port 5432) for a
# regular long-running server like this one.
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
DB_SSL=true

# Running local PostgreSQL instead? Comment DATABASE_URL out above, uncomment
# these, and set DB_SSL=false.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=leaderboard_db
# PGUSER=username
# PGPASSWORD=password

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - the origin(s) your frontend dev will deploy to (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
